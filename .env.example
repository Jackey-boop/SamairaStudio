# ─────────────────────────────────────────────
# Samaira Studio — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# Database
# Local dev (default): SQLite file.
DATABASE_URL="file:./dev.db"
# Production example (Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/samaira?schema=public"

# Initial admin password (protects /admin). This only SEEDS the password
# into the database on first run; afterwards change it from the admin
# panel (Settings tab). Defaults to "admin" if left blank.
ADMIN_PASSWORD="admin"

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (https://resend.com/api-keys)
RESEND_API_KEY=""
EMAIL_FROM="orders@samairastudio.com"
# Admin inbox that receives "work with us" contact submissions.
CONTACT_NOTIFY_EMAIL="hello@samairastudio.com"

# Public (exposed to the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
